{
  "name": "abc-stok-analizi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test": "vitest run --configLoader native",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/build-exceljs.mjs",
    "predev": "node scripts/build-exceljs.mjs",
    "pretest": "node scripts/build-exceljs.mjs",
    "pretypecheck": "node scripts/build-exceljs.mjs",
    "prepare:excel": "node scripts/build-exceljs.mjs",
    "lint": "eslint --max-warnings 0 src tests scripts vite.config.ts eslint.config.mjs",
    "format": "prettier --write \"src/**/*.{tsx,css}\" \"tests/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.{tsx,css}\" \"tests/**/*.tsx\""
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "plotly.js-basic-dist-min": "^3.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "browserify": "17.0.1",
    "core-js": "3.51.0",
    "create-hash": "1.2.0",
    "esbuild": "0.25.12",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "randombytes": "2.1.0",
    "regenerator-runtime": "0.14.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.0.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
